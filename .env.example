# LLM provider: nvidia (default) or gemini
LLM_PROVIDER=nvidia

# NVIDIA NIM (free tier) — https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_MODEL_VLM=meta/llama-3.2-90b-vision-instruct
# Optional comma-separated VLM fallbacks (defaults to NVIDIA_MODEL_VLM only)
NVIDIA_VLM_MODELS=
# Use models your NVIDIA API key can invoke (404 = endpoint not enabled for your account)
NVIDIA_MODEL_PRO=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL_LITE=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_RPM=30

# Optional secondary: Gemini (set LLM_PROVIDER=gemini or keep for future use)
GEMINI_API_KEY=
GEMINI_MODEL_PRO=gemini-3.1-pro-preview
GEMINI_MODEL_FAST=gemini-3.8-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite

# Paths (relative to repo root)
DATA_DIR=data
INDEX_DIR=data/index
LLM_CACHE_DIR=data/cache/llm

# API
API_HOST=0.0.0.0
API_PORT=8000
# Frontend: leave unset to use Next.js /api proxy (recommended). Set only for direct browser→API calls.
# NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_URL=http://127.0.0.1:8000
# Comma-separated browser origins allowed when using NEXT_PUBLIC_API_URL directly
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM client tuning
LLM_MAX_RETRIES=4
LLM_BACKOFF_BASE_SEC=2.0
LLM_BACKOFF_MAX_SEC=60.0
LLM_CACHE_ENABLED=true
